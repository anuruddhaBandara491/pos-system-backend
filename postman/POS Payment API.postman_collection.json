{
  "info": {
    "name": "POS Payment API",
    "_postman_id": "pos-payment-api-2026-01-29",
    "description": "Collection for testing POS payment endpoints (idempotency, balance, status, history).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login (example)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cashier@example.com\",\n  \"password\": \"secret\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api","v1","auth","login"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// store token from login response (adjust path if needed)",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  try {",
              "    const json = pm.response.json();",
              "    if (json.data && json.data.token) {",
              "      pm.environment.set('token', json.data.token);",
              "    } else if (json.token) {",
              "      pm.environment.set('token', json.token);",
              "    }",
              "  } catch (e) {}",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Payments - Submit (Idempotent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": {{amount}},\n  \"method\": \"{{method}}\",\n  \"reference\": \"{{reference}}\",\n  \"metadata\": {\"note\": \"test payment\"}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api","v1","payments","submit"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// generate a guid for Idempotency-Key if not set",
              "if (!pm.environment.get('idempotencyKey')) {",
              "  pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201 or 200', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200,201]);",
              "});",
              "try {",
              "  const json = pm.response.json();",
              "  if (json.data && json.data.paymentId) {",
              "    pm.environment.set('paymentId', json.data.paymentId);",
              "  } else if (json.payment && json.payment.paymentId) {",
              "    pm.environment.set('paymentId', json.payment.paymentId);",
              "  }",
              "  // update token if returned",
              "  if (json.data && json.data.token) pm.environment.set('token', json.data.token);",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Payments - Get Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/balance/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api","v1","payments","balance", "{{orderId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Payments - Get Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api","v1","payments","{{paymentId}}","status"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Payments - Get History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments/history/{{orderId}}?limit=50&offset=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api","v1","payments","history","{{orderId}}"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// ensure idempotencyKey exists for requests that depend on it",
          "if (!pm.environment.get('idempotencyKey')) pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    }
  ]
}
